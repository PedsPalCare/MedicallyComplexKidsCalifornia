---
import { href } from '@/data/site';
interface Item { label: string; path?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs shell" aria-label="Breadcrumb">
  <ol>
    <li><a href={href('/')}>Home</a></li>
    {items.map((item, index) => (
      <li aria-current={index === items.length - 1 ? 'page' : undefined}>
        {item.path && index !== items.length - 1 ? <a href={href(item.path)}>{item.label}</a> : <span>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
