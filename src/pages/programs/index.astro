---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import { programs } from '@/data/programs';
import { href } from '@/data/site';
---
<BaseLayout title="California Programs and Supports" description="Plain-language, sourced guides to California programs and supports for children with medical complexity.">
  <Breadcrumbs items={[{ label: 'Programs and supports' }]} />
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">California Programs and Supports</p>
      <h1>Programs can overlap. They are not interchangeable.</h1>
      <p class="lede">Browse by the question you are trying to answer. Every guide uses the same practical structure and shows its sources, review date, and unresolved expert-review needs.</p>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <div class="callout">
        <strong class="callout-label">Begin with your need</strong>
        <p>Not sure which program name applies? The navigator suggests pathways without making an eligibility determination.</p>
        <a href={href('/start-here')}>Use Start Here</a>
      </div>
      <div class="grid grid-3">
        {programs.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>
</BaseLayout>
