---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
const page = Astro.url.searchParams.get('page') ?? '';
const resource = Astro.url.searchParams.get('resource') ?? '';
---
<BaseLayout title="Report a Correction" description="Prepare a privacy-respecting correction report for California program or resource information.">
  <Breadcrumbs items={[{ label: 'Report a correction' }]} />
  <header class="page-hero"><div class="shell"><p class="eyebrow">Corrections</p><h1>Help keep information accurate.</h1><p class="lede">The secure production intake channel is not configured. You can prepare and download a correction draft without sending private information.</p></div></header>
  <section class="section"><div class="shell form-shell">
    <div class="callout callout-warning"><strong class="callout-label">Do not include private information</strong><p>Do not include a child’s name, medical history, records, insurance number, Social Security number, birth date, address, or school.</p></div>
    <form id="correction-form">
      <div class="field"><label for="correction-item">Page or resource</label><input id="correction-item" name="item" type="text" value={page || resource} required /></div>
      <div class="field"><label for="correction-change">What appears outdated or incorrect?</label><textarea id="correction-change" name="change" required maxlength="1500"></textarea></div>
      <div class="field"><label for="correction-source">Official source supporting the correction</label><input id="correction-source" name="source" type="text" inputmode="url" placeholder="https://…" required /></div>
      <div class="form-actions"><button class="button button-primary" type="submit">Preview correction</button><button class="button button-quiet" type="reset">Clear</button></div>
    </form>
    <section id="correction-preview-section" hidden tabindex="-1" style="margin-top:2rem" aria-labelledby="correction-preview-title"><h2 id="correction-preview-title">Correction draft</h2><div class="preview-box" id="correction-preview"></div><div class="button-row" style="margin-top:1rem"><button class="button button-primary" type="button" id="download-correction">Download draft</button><button class="button button-secondary" type="button" id="copy-correction">Copy draft</button></div><p id="correction-status" role="status" aria-live="polite"></p><p class="small">A named correction recipient and response-time policy must be added before public launch.</p></section>
  </div></section>
  <script>
    const form = document.querySelector('#correction-form'); const section = document.querySelector('#correction-preview-section'); const preview = document.querySelector('#correction-preview'); const status = document.querySelector('#correction-status');
    if (!(form instanceof HTMLFormElement) || !(section instanceof HTMLElement) || !(preview instanceof HTMLElement) || !(status instanceof HTMLElement)) throw new Error('Correction draft tool could not initialize.');
    form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); preview.textContent = `Page or resource: ${data.get('item')}\n\nCorrection requested:\n${data.get('change')}\n\nOfficial source:\n${data.get('source')}\n\nPrepared: ${new Date().toLocaleDateString()}`; section.hidden = false; section.focus(); });
    form.addEventListener('reset', () => setTimeout(() => { section.hidden = true; preview.textContent = ''; }, 0));
    document.querySelector('#copy-correction')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(preview.textContent || ''); status.textContent = 'Correction draft copied.'; } catch { status.textContent = 'Copy was unavailable. Select the preview text manually.'; } });
    document.querySelector('#download-correction')?.addEventListener('click', () => { const blob = new Blob([preview.textContent || ''], { type: 'text/plain;charset=utf-8' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'correction-draft.txt'; link.click(); URL.revokeObjectURL(link.href); status.textContent = 'Correction draft downloaded to this device.'; });
  </script>
</BaseLayout>
