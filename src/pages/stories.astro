---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
---
<BaseLayout title="Family Stories" description="A dignity-centered, private story builder for California families, with no default retention.">
  <Breadcrumbs items={[{ label: 'Family Stories' }]} />
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Family Stories</p>
      <h1>Begin with the child, not the system.</h1>
      <p class="lede">Build a 30-second message, two-minute testimony, email, or longer family-impact statement. Your draft stays in this browser tab unless you choose to copy or download it.</p>
    </div>
  </header>
  <section class="section">
    <div class="shell grid grid-2">
      <article>
        <h2>No public stories are published yet.</h2>
        <p>We will not fabricate testimonials or use a family’s story without a reviewed consent process. Future stories will center joy, relationships, community, participation, and the family’s own requested level of identification.</p>
      </article>
      <aside class="callout callout-warning">
        <strong class="callout-label">Before public story collection</strong>
        <p>Qualified counsel must approve releases involving minors, guardian permission, developmentally appropriate assent, channel-specific consent, withdrawal, retention, photography, press, testimony, and future campaigns.</p>
      </aside>
    </div>
  </section>
  <section class="section section-mist" aria-labelledby="builder-title">
    <div class="shell page-layout">
      <div class="form-shell">
        <p class="eyebrow">Private story builder</p>
        <h2 id="builder-title">Create a draft you control.</h2>
        <div class="privacy-warning"><strong>Protect the child’s privacy.</strong> Do not include medical records, insurance numbers, a Social Security number, full birth date, home address, school name, or details the child may not want shared.</div>
        <form id="story-form" style="margin-top:1.25rem">
          <fieldset>
            <legend>Choose a format</legend>
            <div class="choice-grid">
              <label class="choice"><input type="radio" name="format" value="phone" checked /><span>30-second phone message</span></label>
              <label class="choice"><input type="radio" name="format" value="testimony" /><span>Two-minute testimony</span></label>
              <label class="choice"><input type="radio" name="format" value="email" /><span>Written email</span></label>
              <label class="choice"><input type="radio" name="format" value="impact" /><span>Family-impact statement</span></label>
            </div>
          </fieldset>
          <div class="field"><label for="story-joy">What brings the child or young person joy?</label><textarea id="story-joy" name="joy" maxlength="700"></textarea></div>
          <div class="field"><label for="story-day">What does a good day look like?</label><textarea id="story-day" name="goodDay" maxlength="700"></textarea></div>
          <div class="field"><label for="story-support">What support helps them live at home, learn, or participate?</label><textarea id="story-support" name="support" maxlength="900"></textarea></div>
          <div class="field"><label for="story-barrier">What system barrier occurred?</label><textarea id="story-barrier" name="barrier" maxlength="900"></textarea></div>
          <div class="field"><label for="story-change">What specific change do you want?</label><textarea id="story-change" name="change" maxlength="700"></textarea></div>
          <div class="form-actions"><button class="button button-primary" type="submit">Build preview</button><button class="button button-quiet" type="reset">Clear everything</button></div>
        </form>
        <section id="story-preview-section" hidden tabindex="-1" aria-labelledby="story-preview-title" style="margin-top:2rem">
          <h3 id="story-preview-title">Your private preview</h3>
          <div class="preview-box" id="story-preview"></div>
          <div class="button-row" style="margin-top:1rem"><button class="button button-primary" type="button" id="copy-story">Copy</button><button class="button button-secondary" type="button" id="download-story">Download</button><button class="button button-secondary" type="button" id="print-story">Print</button></div>
          <p id="story-status" role="status" aria-live="polite"></p>
        </section>
      </div>
      <aside class="side-nav">
        <h2>Consent choices for future publication</h2>
        <ul><li>Full name, first name, pseudonym, or anonymous</li><li>Website</li><li>Social media</li><li>Press</li><li>Legislative testimony</li><li>Print</li><li>Photography</li><li>Future campaigns</li></ul>
        <p class="small">Each channel requires a separate choice. This builder does not collect consent or submit a story.</p>
      </aside>
    </div>
  </section>
  <script>
    const form = document.querySelector('#story-form');
    const section = document.querySelector('#story-preview-section');
    const preview = document.querySelector('#story-preview');
    const status = document.querySelector('#story-status');
    if (!(form instanceof HTMLFormElement) || !(section instanceof HTMLElement) || !(preview instanceof HTMLElement) || !(status instanceof HTMLElement)) throw new Error('Story builder could not initialize.');
    const labels: Record<string, string> = { phone: '30-second phone message', testimony: 'Two-minute testimony', email: 'Written email', impact: 'Family-impact statement' };
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const format = String(data.get('format'));
      const sections = [
        ['Meet the child or young person', data.get('joy')],
        ['A good day', data.get('goodDay')],
        ['What makes participation possible', data.get('support')],
        ['The system barrier', data.get('barrier')],
        ['The change I am asking for', data.get('change')]
      ].filter(([, value]) => String(value || '').trim());
      preview.textContent = `${labels[format] || 'Family story'}\n\n${sections.map(([heading, value]) => `${heading}:\n${String(value).trim()}`).join('\n\n')}`;
      section.hidden = false;
      section.focus();
    });
    form.addEventListener('reset', () => setTimeout(() => { preview.textContent = ''; section.hidden = true; status.textContent = 'Draft cleared from this page.'; }, 0));
    document.querySelector('#copy-story')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(preview.textContent || ''); status.textContent = 'Draft copied to your clipboard.'; }
      catch { status.textContent = 'Copy was unavailable. Select the preview text and copy manually.'; }
    });
    document.querySelector('#download-story')?.addEventListener('click', () => {
      const blob = new Blob([preview.textContent || ''], { type: 'text/plain;charset=utf-8' });
      const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'my-family-impact-draft.txt'; link.click(); URL.revokeObjectURL(link.href); status.textContent = 'Draft downloaded to this device.';
    });
    document.querySelector('#print-story')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
