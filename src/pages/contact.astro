---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
---
<BaseLayout title="Contact" description="Contact-channel status and safety information for the California family-navigation project.">
  <Breadcrumbs items={[{ label: 'Contact' }]} />
  <header class="page-hero"><div class="shell"><p class="eyebrow">Contact</p><h1>A production contact channel has not been approved.</h1><p class="lede">The prototype does not publish a fabricated email address or collect messages without a privacy, retention, and response process.</p></div></header>
  <section class="section"><div class="shell reading"><div class="callout callout-warning"><strong class="callout-label">Not monitored</strong><p>This site is not an emergency service and is not continuously monitored. Do not submit medical records or private insurance information.</p></div><h2>Before contact opens</h2><ul><li>Name a response owner and backup.</li><li>Publish realistic response expectations.</li><li>Configure secure validation, rate limits, spam controls, encryption, access roles, and deletion.</li><li>Approve privacy and legal language.</li><li>Provide accessible English and Spanish routes.</li></ul></div></section>
</BaseLayout>
