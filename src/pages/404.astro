---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/data/site';
---
<BaseLayout title="Page not found" description="The requested page could not be found." noindex={true}>
  <section class="section"><div class="shell reading"><p class="eyebrow">404</p><h1>This path does not lead to a page.</h1><p>The page may have moved or the address may be incomplete.</p><div class="button-row"><a class="button button-primary" href={href('/')}>Go home</a><a class="button button-secondary" href={href('/start-here')}>Start Here</a><a class="button button-secondary" href={href('/search')}>Search</a></div></div></section>
</BaseLayout>
